# Postgres connection string (local or Neon / Vercel Postgres)
# Local Homebrew example: postgresql://YOUR_USER@127.0.0.1:5432/jpg_portfolio
# Docker Compose example: postgresql://postgres@127.0.0.1:5432/jpg_portfolio
POSTGRES_URL=postgresql://postgres@127.0.0.1:5432/jpg_portfolio

# Required — use a long random string in production
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Optional locally (media stored on disk). Required on Vercel for uploads.
BLOB_READ_WRITE_TOKEN=

# Public site URL (used for sitemap / SEO)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
